{
  // Base configuration. Deployment-specific values and every secret are supplied by environment
  // variables (double underscore for nesting, e.g. API_Settings__Db__PostgreSqlCnnStr) so nothing
  // sensitive is committed. Placeholders left empty here fail fast at startup with a message that
  // names the missing key.
  "ApplicationName": "CryptoSignal.Api",

  // Surfaced by GET /api/v1/platform. PAPER means no real exchange order is ever authorized.
  "OperatingMode": "PAPER",

  "AllowedHosts": "*",

  // Empty means no cross-origin access at all, rather than a wildcard. The dashboard origin is
  // added per environment.
  "Cors": {
    "AllowedOrigins": []
  },

  "MlService": {
    "Address": "http://localhost:50051",
    "DeadlineSeconds": 10,
    "MaxReceiveMessageMb": 4
  },

  // Global Serilog gate, read by SerilogConfigComposer via ReadFrom.Configuration. Each sink's
  // own MinimumLevel under API_Settings:Logging can only raise the bar above this, never lower
  // it — so drop this to Debug first if a sink needs to emit Debug events.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },

  "API_Settings": {
    "Db": {
      // Only PostgreSql is supported; a different value throws at startup.
      "Type": "PostgreSql",
      "PostgreSqlCnnStr": "",
      "CommandTimeoutSeconds": 30,

      // Keep at 0. A non-zero count installs NpgsqlRetryingExecutionStrategy, which refuses to run
      // inside a transaction the caller began itself — and the user seeder plus the user and role
      // controllers all do exactly that. Raising this requires wrapping each of those transactions in
      // Database.CreateExecutionStrategy() first.
      "MaxRetryCount": 0,
      "MaxRetryDelaySeconds": 10
    },

    "Jwt": {
      // Must be at least 32 bytes: tokens are signed with HMAC-SHA256.
      "SecretKey": "",
      // Reserved. Tokens are signed but not encrypted, so this is currently unused.
      "EncryptKey": "",
      "Issuer": "CryptoSignal",
      "Audience": "CryptoSignal.Clients",
      "NotBeforeMinutes": 0,
      "ExpirationMinutes": 120
    },

    // Bootstrap superadmin created by UserSeeder on first start. Outside Development the seeder
    // refuses to run without SuperAdminPassword rather than fall back to a published default.
    "Bootstrap": {
      "SuperAdminPassword": "",
      "SuperAdminFullName": "System Administrator",
      "SuperAdminEmail": ""
    },

    "Logging": {
      // stdout is the log contract for containers; file and Elastic shipping are opt-in.
      "Sinks": {
        "Console": {
          "Enabled": true,
          "MinimumLevel": "Information",
          "UseAnsiTheme": true,
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "Override": {
            "Microsoft": "Warning",
            "System": "Warning"
          }
        },
        "File": {
          "Enabled": false
        },
        "Elastic": {
          "Enabled": false
        }
      },

      // Read only when Sinks:File:Enabled is true. Empty Root writes next to the assembly.
      "File": {
        "Root": "",
        "UseJson": true,
        "FileSizeLimitBytes": 20000000,
        "RetainedFileCountLimit": 10,
        "MinimumLevel": "Information"
      },

      // Read only when Sinks:Elastic:Enabled is true. There is no Elasticsearch service in the
      // compose stack yet, so this stays off.
      "Elastic": {
        "Enabled": false,
        "Url": "",
        "UserName": "",
        "Password": "",
        "ApiKey": "",
        "RequestTimeoutSeconds": 10,
        "AllowInvalidTls": false,
        "MinimumLevel": "Information"
      },

      // Logs every EF Core command. Off by default: it is verbose and echoes parameter values.
      "EfCommandTracer": {
        "Enabled": false,
        "LogCommandText": true,
        "LogParameters": false,
        "MaxValueLength": 120,
        "MinDurationMs": 0
      }
    }
  }
}
