{
  // Base configuration. Deployment-specific values and every secret are supplied by environment
  // variables (double underscore for nesting, e.g. API_Settings__Db__PostgreSqlCnnStr) so nothing
  // sensitive is committed. Placeholders left empty here fail fast at startup with a message that
  // names the missing key.
  "ApplicationName": "CryptoSignal.Api",

  // Surfaced by GET /api/v1/platform. PAPER means no real exchange order is ever authorized.
  "OperatingMode": "PAPER",

  "AllowedHosts": "*",

  // Empty means no cross-origin access at all, rather than a wildcard. The dashboard origin is
  // added per environment.
  "Cors": {
    "AllowedOrigins": []
  },

  "MlService": {
    "Address": "http://localhost:50051",
    "DeadlineSeconds": 10,
    "MaxReceiveMessageMb": 4
  },

  // The bot scheduler and the pre-trade risk ceilings. Every limit here is a HARD ceiling on top of
  // each bot's own configured limit, and the tighter of the two always wins. A zero or missing limit
  // DENIES — it never means "unlimited" (docs/LIVE_TRADING_SAFETY.md). An unconfigured deployment
  // therefore trades nothing, which is the safe state, not a misconfiguration to be worked around.
  "Trading": {
    // The scheduler is off until a deployment turns it on. Left false so importing the schema, running
    // migrations or standing up the API never starts placing orders as a side effect.
    "SchedulerEnabled": false,
    "PollSeconds": 15,
    "MaxBotsPerCycle": 20,
    "CandleWindowSize": 300,
    "TickTimeoutSeconds": 60,
    "LeaseStaleSeconds": 180,

    "Risk": {
      // Master switch for real money. False keeps every LIVE bot denied no matter what else is set;
      // the live-execution gates are not implemented, so this stays false.
      "AllowLiveExecution": false,
      "EnabledOperatingModes": [ "PAPER", "SANDBOX" ],
      // Empty denies every symbol. There is deliberately no "all symbols" value — a tradable universe
      // is always an explicit list.
      "AllowedSymbols": [ "BTCUSDT", "ETHUSDT", "BNBUSDT", "SOLUSDT" ],
      "SpotOnly": true,
      "MaxLeverage": 1,
      "AllowShorting": false,
      // Quote-currency ceilings. Non-zero so PAPER and SANDBOX can actually trade; still ceilings, not
      // targets — a bot's own smaller limit wins.
      "MaxOrderNotional": 100,
      "MaxPositionNotional": 500,
      "MaxDailyLoss": 200,
      "MaxOrdersPerDay": 50,
      "MaxConcurrentPositions": 3,
      "MaxCandleAgeIntervals": 2.5,
      "MaxConsecutiveFailures": 5,
      // Empty means "do not pin a model version" — permissive on which model answers, which is safe
      // because the version is still recorded on every decision.
      "ApprovedModelVersions": []
    },

    // The PAPER simulator's cost model. Slippage is charged adverse-only; the balance is a constant the
    // risk check reads, not a running wallet (realised P&L lives on BotPositions).
    "Paper": {
      "SlippageBps": 5,
      "FeeBps": 10,
      "QuoteBalance": 10000
    }
  },

  // Exchange venues. Base URLs have safe compile-time defaults, so these keys are optional; CREDENTIALS
  // are not set here and must come from the server environment only —
  // Exchange__BinanceTestnet__ApiKey / Exchange__BinanceTestnet__ApiSecret — never a response body or
  // the browser. An empty key means "this venue cannot be traded", which is the intended default: PAPER
  // needs no credentials at all, and SANDBOX stays denied until keys are supplied out of band.
  "Exchange": {
    "RecvWindowMs": 5000,
    "RequestTimeoutSeconds": 15,
    "BinanceTestnet": {
      "RestBaseUrl": "https://testnet.binance.vision",
      "ApiKey": "",
      "ApiSecret": "",
      "ProxyUrl": ""
    },
    "BinanceMainnet": {
      "RestBaseUrl": "https://api.binance.com",
      "ApiKey": "",
      "ApiSecret": "",
      // Mainnet is unreachable from inside the containers today. A host-side proxy URL goes here when
      // egress is arranged; empty means no proxy, and the venue simply faults any bot pointed at it.
      "ProxyUrl": ""
    },
    // Bitunix's OpenAPI base. ApiKey/ApiSecret here are the operator-level fallback: per-user keys are
    // stored sealed in the database via the exchange-connections screen and win when present.
    "Bitunix": {
      "RestBaseUrl": "https://fapi.bitunix.com",
      "ApiKey": "",
      "ApiSecret": "",
      "ProxyUrl": ""
    }
  },

  // The replay market-data source reads <SYMBOL>_<interval>.csv from this directory. Empty is not a
  // default path: the replay source throws rather than guess, so tests must point this at their fixture
  // directory explicitly. Runtime bots use a live venue, not replay.
  "MarketData": {
    "ReplayDataDirectory": "",

    // Which venue's candles the on-demand signal endpoint reads. The testnet, because it is the venue
    // reachable from inside the container network and the same one SANDBOX fills at — so a signal and
    // the execution that follows it are computed from one venue's prices. There is no fallback: an
    // unreachable venue produces an error, never a substituted answer from somewhere else.
    "SignalVenue": "BinanceTestnet"
  },

  // Global Serilog gate, read by SerilogConfigComposer via ReadFrom.Configuration. Each sink's
  // own MinimumLevel under API_Settings:Logging can only raise the bar above this, never lower
  // it — so drop this to Debug first if a sink needs to emit Debug events.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },

  // Market scanner: 24h tickers -> rank symbols -> engine ScanSymbols -> ScannerSignal proposals.
  // Disabled by default; proposals never place orders. Scanner-kind bots claim them.
  "Scanner": {
    "Enabled": false,
    "ScanIntervalMinutes": 5,
    "MaxSymbolsPerPass": 20,
    "CandleCount": 300,
    "Interval": "5m",
    "Venue": "BinanceFuturesTestnet",
    "StrategyKeys": [ "rsi", "bollinger", "macd", "ema_cross", "supertrend" ],
    "DefaultTakeProfitAtr": 1.5,
    "DefaultStopLossAtr": 1.0
  },

  "API_Settings": {
    "Db": {
      // Only PostgreSql is supported; a different value throws at startup.
      "Type": "PostgreSql",
      "PostgreSqlCnnStr": "",
      "CommandTimeoutSeconds": 30,

      // Keep at 0. A non-zero count installs NpgsqlRetryingExecutionStrategy, which refuses to run
      // inside a transaction the caller began itself — and the user seeder plus the user and role
      // controllers all do exactly that. Raising this requires wrapping each of those transactions in
      // Database.CreateExecutionStrategy() first.
      "MaxRetryCount": 0,
      "MaxRetryDelaySeconds": 10
    },

    "Jwt": {
      // Must be at least 32 bytes: tokens are signed with HMAC-SHA256.
      "SecretKey": "",
      // Reserved. Tokens are signed but not encrypted, so this is currently unused.
      "EncryptKey": "",
      "Issuer": "CryptoSignal",
      "Audience": "CryptoSignal.Clients",
      "NotBeforeMinutes": 0,
      "ExpirationMinutes": 120
    },

    // Bootstrap superadmin created by UserSeeder on first start. Outside Development the seeder
    // refuses to run without SuperAdminPassword rather than fall back to a published default.
    "Bootstrap": {
      "SuperAdminPassword": "",
      "SuperAdminFullName": "System Administrator",
      "SuperAdminEmail": ""
    },

    "Logging": {
      // stdout is the log contract for containers; file and Elastic shipping are opt-in.
      "Sinks": {
        "Console": {
          "Enabled": true,
          "MinimumLevel": "Information",
          "UseAnsiTheme": true,
          "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "Override": {
            "Microsoft": "Warning",
            "System": "Warning"
          }
        },
        "File": {
          "Enabled": false
        },
        "Elastic": {
          "Enabled": false
        }
      },

      // Read only when Sinks:File:Enabled is true. Empty Root writes next to the assembly.
      "File": {
        "Root": "",
        "UseJson": true,
        "FileSizeLimitBytes": 20000000,
        "RetainedFileCountLimit": 10,
        "MinimumLevel": "Information"
      },

      // Read only when Sinks:Elastic:Enabled is true. There is no Elasticsearch service in the
      // compose stack yet, so this stays off.
      "Elastic": {
        "Enabled": false,
        "Url": "",
        "UserName": "",
        "Password": "",
        "ApiKey": "",
        "RequestTimeoutSeconds": 10,
        "AllowInvalidTls": false,
        "MinimumLevel": "Information"
      },

      // Logs every EF Core command. Off by default: it is verbose and echoes parameter values.
      "EfCommandTracer": {
        "Enabled": false,
        "LogCommandText": true,
        "LogParameters": false,
        "MaxValueLength": 120,
        "MinDurationMs": 0
      }
    }
  }
}
