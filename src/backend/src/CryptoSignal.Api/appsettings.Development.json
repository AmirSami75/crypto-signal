{
  // Local development overrides. The credentials below are development-only and match
  // devops/env/dev/db.env — they must never be reused anywhere reachable.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },

  // Development overrides for the bot scheduler. The scheduler runs here — this is the only environment
  // where it is on by default — because PAPER places nothing at a venue, so a ticking bot costs nothing
  // but the log lines that prove the chain works. Everything else stays as fail-closed as production:
  // live execution off, shorting off, spot only.
  "Trading": {
    "SchedulerEnabled": true,
    // Faster than production's 15s so a dev tick is visible without waiting out a candle.
    "PollSeconds": 10,
    "Risk": {
      "AllowLiveExecution": false,
      "EnabledOperatingModes": [ "PAPER", "SANDBOX" ],
      "AllowedSymbols": [ "BTCUSDT", "ETHUSDT", "BNBUSDT", "SOLUSDT", "XRPUSDT", "ADAUSDT", "DOGEUSDT" ],
      "SpotOnly": true,
      "AllowShorting": false,
      "MaxOrderNotional": 100,
      "MaxPositionNotional": 500,
      "MaxDailyLoss": 200,
      "MaxOrdersPerDay": 50,
      "MaxConcurrentPositions": 3,
      "MaxCandleAgeIntervals": 2.5,
      "MaxConsecutiveFailures": 5
    }
  },

  // Points the replay source at the recordings the ML engine trains on, so a replayed bot and a trained
  // model see byte-identical candles. This is the container path that compose.dev.yml mounts
  // src/signal-ml/data at; running the API on the host needs MarketData__ReplayDataDirectory set instead.
  "MarketData": {
    "ReplayDataDirectory": "/workspace/data/replay"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },

  "API_Settings": {
    "Db": {
      // Points at the PostgreSQL published by the compose stack (devops/compose.yml, service "db"),
      // for a bare-metal `dotnet run` on the host. Inside the compose network the api container
      // overrides this with Host=db via devops/env/dev/api.env.
      //
      // 127.0.0.1 and not localhost: compose publishes the port as 127.0.0.1:5432, so the listener is
      // IPv4-only, while localhost resolves to ::1 first on a stock Arch host. Npgsql then connects to
      // ::1:5432 and fails with "Connection refused" even though the database is up.
      "PostgreSqlCnnStr": "Host=127.0.0.1;Port=5432;Database=crypto_signal;Username=crypto_signal;Password=development-only-postgres-password"
    },

    "Jwt": {
      // Development-only signing key, 48 bytes. Production supplies its own via
      // API_Settings__Jwt__SecretKey.
      "SecretKey": "development-only-jwt-signing-key-do-not-reuse-01",
      "ExpirationMinutes": 480
    },

    // Left empty on purpose: in Development the seeder falls back to the built-in default password
    // and logs a warning, so a developer can log in as cs-admin without extra setup.
    "Bootstrap": {
      "SuperAdminPassword": "",
      "SuperAdminEmail": "admin@crypto-signal.local"
    },

    "Logging": {
      "Sinks": {
        "Console": {
          "MinimumLevel": "Debug",
          "Override": {
            "Microsoft": "Information",
            "System": "Warning"
          }
        },
        "File": {
          // Off on purpose. FileSerilogConfig resolves Root relative to the content root, which under
          // the dev container is the bind-mounted source tree — so every log line writes a file inside
          // the repo and makes `dotnet watch` re-evaluate the project. The console sink at Debug
          // already carries the same events. Flip this to true for a bare-metal run if you want the
          // rolling file, and keep Logs/ out of version control.
          "Enabled": false
        }
      },

      "File": {
        "Root": "Logs",
        "UseJson": false,
        "MinimumLevel": "Debug"
      },

      "EfCommandTracer": {
        "Enabled": true,
        "LogParameters": true,
        "MinDurationMs": 0
      }
    }
  }
}
