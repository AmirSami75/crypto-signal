{
  // Local development overrides. The credentials below are development-only and match
  // devops/env/dev/db.env — they must never be reused anywhere reachable.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },

  // Development overrides for the bot scheduler. The scheduler runs here — this is the only environment
  // where it is on by default — because PAPER places nothing at a venue, so a ticking bot costs nothing
  // but the log lines that prove the chain works. Everything else stays as fail-closed as production:
  // live execution off, shorting off, spot only.
  "Trading": {
    "SchedulerEnabled": true,
    // A scanner bot claims only proposals whose expected R clears this floor. 0.05R is deliberately
    // thin for the demo: the 5m model rarely prices a bet above 0.10R today, and a bot that never fires
    // proves nothing about the chain. Fees are ~0.10R per round trip at a 1-ATR stop, so this is a
    // visibility threshold, not a profitability claim.
    "ScannerMinimumScore": 0.05,
    // Faster than production's 15s so a dev tick is visible without waiting out a candle.
    "PollSeconds": 10,
    "Risk": {
      "AllowLiveExecution": false,
      "EnabledOperatingModes": [ "PAPER", "SANDBOX" ],
      // The liquid universe a scanner bot may act on. This is the *risk* allowlist, not the scan list:
      // the scanner prices ~250 symbols, and this list decides which of its proposals may become orders.
      // Forty majors/liquid perps, trimmed from Binance's >$10M USDT-perp set.
      "AllowedSymbols": [
        "BTCUSDT","ETHUSDT","BNBUSDT","SOLUSDT","XRPUSDT","ADAUSDT","DOGEUSDT","AVAXUSDT",
        "LINKUSDT","DOTUSDT","LTCUSDT","BCHUSDT","TRXUSDT","TONUSDT","SUIUSDT","APTUSDT",
        "ARBUSDT","OPUSDT","NEARUSDT","ATOMUSDT","FILUSDT","INJUSDT","SEIUSDT","TIAUSDT",
        "1000PEPEUSDT","WIFUSDT","ENAUSDT","AAVEUSDT","UNIUSDT","HBARUSDT","ICPUSDT","ETCUSDT",
        "XLMUSDT","ALGOUSDT","VETUSDT","RENDERUSDT","FETUSDT","JUPUSDT","WLDUSDT","ONDOUSDT",
        // Mid-cap perps the 5m model actually proposes most often on testnet. The allowlist is a
        // market-eligibility gate, not a spending gate: every order still passes the notional, daily
        // loss, frequency and balance checks below it.
        "EPICUSDT","TRBUSDT","MOCAUSDT","POLYXUSDT","RUNEUSDT","UBUSDT","ONUSDT","TWTUSDT",
        "TRADOORUSDT","ASTERUSDT","LINEAUSDT","ZKUSDT","EIGENUSDT","BERAUSDT","KAITOUSDT","IPUSDT",
        "AEROUSDT","MORPHOUSDT","SYRUPUSDT","SPKUSDT","PROVEUSDT","DOLOUSDT","TREEUSDT","GUNUSDT",
        "INITUSDT","REDUSDT","STBLUSDT","AVNTUSDT","SOMIUSDT","OPENUSDT","PLUMEUSDT","HEMIUSDT",
        "BARDUSDT","XPLUSDT","FFUSDT","2ZUSDT","PENGUUSDT","FARTCOINUSDT","SPXUSDT","MOODENGUSDT",
        // Mid-caps the scanner proposes most often; added so a PAPER bot can demonstrate the
        // full chain (claim → intent → risk → fill) without waiting for a majors-only proposal.
        "BANANAS31USDT","BIOUSDT","FRAXUSDT","ARCUSDT","GRIFFAINUSDT","CUSDT","CHILLGUYUSDT","JOEUSDT","1000RATSUSDT","B2USDT","AVAAIUSDT","AIOTUSDT","IDOLUSDT","TUTUSDT","ZAMAUSDT",
        "AKEUSDT","SKYAIUSDT","HOTUSDT","BEAMXUSDT","KORUUSDT","ICNTUSDT","PUMPBTCUSDT","PARTIUSDT","STABLEUSDT","TAGUSDT","BRUSDT","BROCCOLIF3BUSDT","XMRUSDT","PROMPTUSDT","HAEDALUSDT","KAVAUSDT","XPINUSDT","HANAUSDT","HUSDT","PENDLEUSDT","TSTUSDT","RSRUSDT","SPYUSDT","BTCDOMUSDT","IRUSDT","MIRAUSDT","TACUSDT","AXLUSDT","QQQUSDT","FOGOUSDT","AMZNUSDT","PLAYUSDT","SQDUSDT","RAYSOLUSDT","BMTUSDT"
      ],
      "SpotOnly": true,
      "AllowShorting": true,
      "MaxOrderNotional": 100,
      "MaxPositionNotional": 500,
      "MaxDailyLoss": 200,
      "MaxOrdersPerDay": 50,
      "MaxConcurrentPositions": 3,
      "MaxCandleAgeIntervals": 2.5,
      "MaxConsecutiveFailures": 5
    }
  },

  // Points the replay source at the recordings the ML engine trains on, so a replayed bot and a trained
  // model see byte-identical candles. This is the container path that compose.dev.yml mounts
  // src/signal-ml/data at; running the API on the host needs MarketData__ReplayDataDirectory set instead.
  "MarketData": {
    "ReplayDataDirectory": "/workspace/data/replay"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },

  "API_Settings": {
    "Db": {
      // Points at the PostgreSQL published by the compose stack (devops/compose.yml, service "db"),
      // for a bare-metal `dotnet run` on the host. Inside the compose network the api container
      // overrides this with Host=db via devops/env/dev/api.env.
      //
      // 127.0.0.1 and not localhost: compose publishes the port as 127.0.0.1:5432, so the listener is
      // IPv4-only, while localhost resolves to ::1 first on a stock Arch host. Npgsql then connects to
      // ::1:5432 and fails with "Connection refused" even though the database is up.
      "PostgreSqlCnnStr": "Host=127.0.0.1;Port=5432;Database=crypto_signal;Username=crypto_signal;Password=development-only-postgres-password"
    },

    "Jwt": {
      // Development-only signing key, 48 bytes. Production supplies its own via
      // API_Settings__Jwt__SecretKey.
      "SecretKey": "development-only-jwt-signing-key-do-not-reuse-01",
      "ExpirationMinutes": 480
    },

    // Left empty on purpose: in Development the seeder falls back to the built-in default password
    // and logs a warning, so a developer can log in as cs-admin without extra setup.
    "Bootstrap": {
      "SuperAdminPassword": "",
      "SuperAdminEmail": "admin@crypto-signal.local"
    },

    "Logging": {
      "Sinks": {
        "Console": {
          "MinimumLevel": "Debug",
          "Override": {
            "Microsoft": "Information",
            "System": "Warning"
          }
        },
        "File": {
          // Off on purpose. FileSerilogConfig resolves Root relative to the content root, which under
          // the dev container is the bind-mounted source tree — so every log line writes a file inside
          // the repo and makes `dotnet watch` re-evaluate the project. The console sink at Debug
          // already carries the same events. Flip this to true for a bare-metal run if you want the
          // rolling file, and keep Logs/ out of version control.
          "Enabled": false
        }
      },

      "File": {
        "Root": "Logs",
        "UseJson": false,
        "MinimumLevel": "Debug"
      },

      "EfCommandTracer": {
        "Enabled": true,
        "LogParameters": true,
        "MinDurationMs": 0
      }
    }
  }
}
