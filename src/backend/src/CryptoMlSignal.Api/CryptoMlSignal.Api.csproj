<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CryptoMlSignal.Api</RootNamespace>
    <AssemblyName>CryptoMlSignal.Api</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../../../contracts/crypto_signal_engine/contracts/v1/ml_engine.proto"
              GrpcServices="Client"
              Link="Protos/ml_engine.proto" />
  </ItemGroup>
</Project>
