# {{ ansible_managed }} — {{ env_set }} api.env. Secrets come from vault.yml, never plaintext.
ASPNETCORE_ENVIRONMENT={{ env_api.ASPNETCORE_ENVIRONMENT }}
ASPNETCORE_URLS={{ env_api.ASPNETCORE_URLS }}
OperatingMode={{ env_api.OperatingMode }}
MlService__Address={{ env_api.MlService__Address }}
MlService__DeadlineSeconds={{ env_api.MlService__DeadlineSeconds }}
MlService__MaxReceiveMessageMb={{ env_api.MlService__MaxReceiveMessageMb }}
{% if env_api.Cors__AllowedOrigins__0 is defined %}Cors__AllowedOrigins__0={{ env_api.Cors__AllowedOrigins__0 }}
{% endif %}API_Settings__Db__Type={{ env_api.API_Settings__Db__Type }}
API_Settings__Db__PostgreSqlCnnStr={{ vault_postgres_cnn }}
Sercurity__KeyEncryptionKey={{ vault_kek }}
API_Settings__Jwt__SecretKey={{ vault_jwt_secret }}
API_Settings__Jwt__Issuer={{ vault_jwt_issuer }}
API_Settings__Jwt__Audience={{ vault_jwt_audience }}
API_Settings__Jwt__ExpirationMinutes={{ vault_jwt_expiry_minutes }}
API_Settings__Bootstrap__SuperAdminPassword={{ vault_bootstrap_admin_password }}
