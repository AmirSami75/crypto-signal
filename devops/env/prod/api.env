# Inject every blank value through production secret management. The API refuses to start when a
# required key is missing, and names the key in the failure message.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Surfaced by GET /api/v1/platform. PAPER means no real exchange order is ever authorized.
OperatingMode=PAPER

MlService__Address=http://signal-ml:50051
MlService__DeadlineSeconds=10
MlService__MaxReceiveMessageMb=4

# Origin the dashboard is served from. Blank means no cross-origin access at all.
Cors__AllowedOrigins__0=

# Npgsql connection string, e.g.
# Host=db;Port=5432;Database=...;Username=...;Password=...
API_Settings__Db__Type=PostgreSql
API_Settings__Db__PostgreSqlCnnStr=

# Required. At least 32 bytes: tokens are signed with HMAC-SHA256.
API_Settings__Jwt__SecretKey=
API_Settings__Jwt__Issuer=CryptoSignal
API_Settings__Jwt__Audience=CryptoSignal.Clients
API_Settings__Jwt__ExpirationMinutes=120

# Required outside Development. UserSeeder creates the superadmin (username cs-admin) with this
# password on first start, flagged for a mandatory change at first login. Without it the seeder
# throws rather than fall back to the password published in the source tree.
API_Settings__Bootstrap__SuperAdminPassword=
API_Settings__Bootstrap__SuperAdminFullName=System Administrator
API_Settings__Bootstrap__SuperAdminEmail=
