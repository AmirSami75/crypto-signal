ML_ENVIRONMENT=production
OPERATING_MODE=PAPER
ML_GRPC_HOST=0.0.0.0
ML_GRPC_PORT=50051
ML_GRPC_WORKERS=8
ML_MODEL_DIR=/app/artifacts/models
# Deliberately unset: the registry is the supported layout. Setting it makes a single artifact servable
# alongside the directory, which is a migration aid, not a production arrangement.
# ML_MODEL_PATH=
ML_DEFAULT_MAX_HOLDING_PERIODS=0
ML_MINIMUM_CONFIDENCE=0.0
ML_BARRIER_ATR_BOUNDS=0.5,4.0
ML_MINIMUM_CANDLES=169
ML_MAXIMUM_CANDLES=2000
ML_MAX_RECEIVE_MESSAGE_MB=16
ML_MAX_SEND_MESSAGE_MB=4
ML_SHUTDOWN_GRACE_SECONDS=30
ML_ENABLE_REFLECTION=false
ML_LOG_LEVEL=INFO
ML_LOG_FORMAT=json
# For native TLS or mTLS, mount certificates and set all applicable paths below.
ML_TLS_CERTIFICATE_PATH=
ML_TLS_PRIVATE_KEY_PATH=
ML_TLS_CLIENT_CA_PATH=
