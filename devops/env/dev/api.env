# Development-only. Never reuse these values anywhere reachable.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Surfaced by GET /api/v1/platform. PAPER means no real exchange order is ever authorized.
OperatingMode=PAPER

MlService__Address=http://signal-ml:50051
MlService__DeadlineSeconds=10
MlService__MaxReceiveMessageMb=4

Cors__AllowedOrigins__0=http://localhost:5173

# Overrides the localhost value in appsettings.Development.json: inside the compose network the
# database answers on the "db" service name, not on localhost.
API_Settings__Db__Type=PostgreSql
API_Settings__Db__PostgreSqlCnnStr=Host=db;Port=5432;Database=crypto_signal;Username=crypto_signal;Password=development-only-postgres-password

# The JWT signing key and the bootstrap superadmin password are left to
# appsettings.Development.json so a bare-metal `dotnet run` behaves the same as the container.
# Production supplies both here instead — see env/prod/api.env.

# Master key for AES-GCM sealing of stored exchange API keys (ExchangeConnections screen).
# Development-only value; production must supply its own and keep it out of the repo.
Sercurity__KeyEncryptionKey=VkXn5G+tCnZzGh5CLug4bAQKjPwpqheXFkt6YQkm2iA=
