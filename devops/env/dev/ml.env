ML_ENVIRONMENT=development
OPERATING_MODE=PAPER
ML_GRPC_HOST=0.0.0.0
ML_GRPC_PORT=50051
ML_GRPC_WORKERS=8
ML_MODEL_DIR=/app/artifacts/models
# The registry is currently a single directory; the Bybit demo 5m bundle is copied into it only after
# its validation. This is intentionally not enabled until the adapter is live-tested.
# ML_MODEL_DIR=/app/artifacts_5m/models
# ML_MODEL_PATH=/app/artifacts/model.joblib   # single-artifact fallback; a directory bundle wins over it
# 0 defers to the horizon each bundle was labelled at, which is the only value guaranteed to match the
# bet the model was trained on.
ML_DEFAULT_MAX_HOLDING_PERIODS=0
# The engine's floor when a request sets none. Left at 0 so the engine reports what it sees and the
# orchestrator's risk engine owns policy; a floor here would silently filter before risk ever ran.
ML_MINIMUM_CONFIDENCE=0.0
# Span of the trained barrier grid, in ATR. A request outside it is answered with an extrapolation
# warning rather than refused.
ML_BARRIER_ATR_BOUNDS=0.5,4.0
ML_MINIMUM_CANDLES=169
ML_MAXIMUM_CANDLES=2000
ML_MAX_RECEIVE_MESSAGE_MB=16
ML_MAX_SEND_MESSAGE_MB=4
ML_SHUTDOWN_GRACE_SECONDS=20
ML_ENABLE_REFLECTION=true
ML_LOG_LEVEL=INFO
ML_LOG_FORMAT=text
