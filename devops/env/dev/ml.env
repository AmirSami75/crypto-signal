ML_ENVIRONMENT=development
OPERATING_MODE=PAPER
ML_GRPC_HOST=0.0.0.0
ML_GRPC_PORT=50051
ML_GRPC_WORKERS=8
ML_MODEL_PATH=/app/artifacts/model.joblib
ML_MINIMUM_CANDLES=169
ML_MAXIMUM_CANDLES=2000
ML_MAX_RECEIVE_MESSAGE_MB=16
ML_MAX_SEND_MESSAGE_MB=4
ML_SHUTDOWN_GRACE_SECONDS=20
ML_ENABLE_REFLECTION=true
ML_LOG_LEVEL=INFO
ML_LOG_FORMAT=text
